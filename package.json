{
  "name": "classroom-quiz-scoreboard",
  "version": "1.0.0",
  "description": "Offline-first Live Quiz Competition Scoreboard with Classroom-inspired UI",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build:client": "vite build --config client/vite.config.js",
    "start": "npm run build:client && node server/index.js",
    "electron": "electron electron/main.js",
    "electron:start": "npm run build:client && electron electron/main.js",
    "test": "node --test server/test/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "vite": "^6.2.0"
  }
}
